# =============================================================================
# SIGEA UIDE — Variables de Entorno (Maestro)
# =============================================================================
# Archivo único de referencia. Copiar a .env en cada servicio o usar
# docker-compose con env_file apuntando aquí.
# El script scripts/validate-env.js verifica que TODAS las requeridas existan
# al iniciar backend, bot o n8n.

# =============================================================================
# GENERAL
# =============================================================================
NODE_ENV=development                    # development | production
DOMAIN=                                 # Vacío = HTTP por IP; con valor = HTTPS + Let's Encrypt
TZ=America/Guayaquil

# =============================================================================
# BASE DE DATOS (PostgreSQL)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DB_NAME=gestion_aulas

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_ESTA_CONTRASENA
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# =============================================================================
# BACKEND
# =============================================================================
BACKEND_PORT=3000                       # Puerto interno Docker (3001 en dev local)
JWT_SECRET=GENERAR_64_CHARS_ALEATORIOS  # openssl rand -base64 48
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (DESACTIVADO en app.js línea 57 — habilitar en prod)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000

# Uploads
UPLOAD_MAX_SIZE=10485760                # 10MB
UPLOAD_PATH=./uploads                   # Debe coincidir con volumen Docker /app/uploads

# OpenAI (requerido si AI_REPORTE_DISTRIBUCION=true o se usa ia-consulta)
OPENAI_API_KEY=

# n8n
N8N_HOST=n8n
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=CAMBIAR_ESTA_CONTRASENA
N8N_WEBHOOK_URL=http://n8n:5678/webhook
AI_REPORTE_DISTRIBUCION=false           # true = GPT-4o en reportes (costo tokens)

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CAMBIAR_ESTA_KEY
EVOLUTION_INSTANCE=botuide              # Nombre REAL de la instancia conectada

# SMTP (Outlook / Microsoft 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu.correo@outlook.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM="Sistema Gestion Aulas UIDE" <tu.correo@outlook.com>

# SMTP alternativo: Gmail (descomentar si usas Gmail en lugar de Outlook)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu.correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
# SMTP_FROM="Sistema Gestion Aulas UIDE" <tu.correo@gmail.com>

# SMTP Institucional UIDE (opcional)
# SMTP_UIDE_HOST=smtp.office365.com
# SMTP_UIDE_PORT=587
# SMTP_UIDE_SECURE=false
# SMTP_UIDE_USER=sistema_sigea@uide.edu.ec
# SMTP_UIDE_PASS=contraseña_institucional
# SMTP_UIDE_FROM="Sistema Gestion Aulas UIDE" <sistema_sigea@uide.edu.ec>

# =============================================================================
# FRONTEND (Vite)
# =============================================================================
VITE_API_URL=/api                       # En prod nginx hace proxy /api → backend
VITE_APP_TITLE=SIGEA UIDE

# =============================================================================
# WHATSAPP BOT (whatsapp-bot-aulas/)
# =============================================================================
BOT_PORT=3020
BOT_EVOLUTION_URL=http://evolution-api:8080
BOT_EVOLUTION_KEY=${EVOLUTION_API_KEY}
BOT_INSTANCE_NAME=${EVOLUTION_INSTANCE}
BOT_BACKEND_URL=http://backend:3000/api
BOT_N8N_WEBHOOK_URL=${N8N_WEBHOOK_URL}

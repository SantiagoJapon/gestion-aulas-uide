# ============================================
# Variables de Produccion - Gestion Aulas UIDE
# ============================================

# --- Base de Datos ---
DB_USER=postgres
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DB_NAME=gestion_aulas

# --- Redis ---
REDIS_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# --- Backend ---
JWT_SECRET=CAMBIAR_ESTE_SECRET
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost

# --- Dominio (para SSL con Let's Encrypt) ---
# Dejar vacio para usar IP directa (sin SSL)
DOMAIN=

# --- n8n (solo acceso interno; orquestación de notificaciones/reportes/IA) ---
N8N_USER=admin
N8N_PASSWORD=CAMBIAR_ESTA_CONTRASENA
N8N_WEBHOOK_URL=http://n8n:5678/webhook
# Si es true, n8n enriquece reportes con GPT-4o (costo por token). Default: false
AI_REPORTE_DISTRIBUCION=false

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CAMBIAR_ESTA_KEY
EVOLUTION_INSTANCE=botuide

# --- Voz (Groq Whisper - opcional) ---
VOICE_API_KEY=

# --- OpenAI (opcional, para extraccion de estudiantes) ---
OPENAI_API_KEY=

# --- Anthropic (opcional) ---
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic

# --- SMTP General (Outlook / Microsoft 365) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@outlook.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM="Sistema Gestion Aulas UIDE" <tu_correo@outlook.com>

# --- SMTP Institucional UIDE (opcional) ---
# SMTP_UIDE_HOST=smtp.office365.com
# SMTP_UIDE_PORT=587
# SMTP_UIDE_SECURE=false
# SMTP_UIDE_USER=sistema_sigea@uide.edu.ec
# SMTP_UIDE_PASS=contraseña_institucional

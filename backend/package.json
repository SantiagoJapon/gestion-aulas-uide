{
  "name": "gestion-aulas-backend",
  "version": "1.0.0",
  "description": "Backend para gestión de aulas UIDE",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --testPathPatterns=tests/",
    "test:watch": "jest --testPathPatterns=tests/ --watch",
    "test:coverage": "jest --testPathPatterns=tests/ --coverage",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "db:migrate:generate": "npx sequelize-cli model:generate"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "./tests/jest-setup.js"
    ]
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "nodemon": "^3.0.2",
    "openai": "^4.20.0",
    "pdfmake": "^0.3.3",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "redis": "^6.0.1",
    "sequelize": "^6.35.0",
    "validator": "^13.11.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
